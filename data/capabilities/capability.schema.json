{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darktable.org/schemas/capability/v1",
  "title": "darktable capability",
  "type": "object",
  "required": ["schema_version", "id", "version", "name", "description", "contexts", "arguments", "side_effect", "lifecycle", "agent_exposure"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "synonyms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "examples": { "type": "array", "items": { "type": "string" } },
    "help_reference": { "type": "string" },
    "contexts": {
      "type": "array",
      "items": { "enum": ["global", "library", "edit", "export"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "selection": {
      "type": "object",
      "required": ["required", "multiple"],
      "properties": {
        "required": { "type": "boolean" },
        "multiple": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "required"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["boolean", "integer", "number", "string", "enum"] },
          "required": { "type": "boolean" },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" },
          "default": {},
          "description": { "type": "string" },
          "values": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "side_effect": { "enum": ["read_only", "reversible_edit", "library_mutation", "file_output", "destructive"] },
    "lifecycle": {
      "type": "object",
      "required": ["preview", "confirmation", "undo", "cancellation"],
      "properties": {
        "preview": { "type": "boolean" },
        "confirmation": { "type": "boolean" },
        "undo": { "type": "boolean" },
        "cancellation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "navigation_target": { "type": "string" },
    "agent_exposure": { "enum": ["internal_only", "discovery", "read_only", "previewable", "executable"] }
  },
  "additionalProperties": false
}
